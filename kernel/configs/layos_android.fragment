# Fragmento adicional do kernel para rodar o Android (Lay-Android)
# Aplicado depois de layos_x86.fragment por tools/build/build-kernel.sh

# Dispositivos loop e sistemas de arquivos usados pelos APEX do Android 12+
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=32
CONFIG_EROFS_FS=y
CONFIG_KEYS=y

# Gerador de numeros aleatorios (Android 13: prng_seeder usa /dev/hw_random)
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# Monitoramento de pressao de memoria (lmkd) e controle de recursos
CONFIG_PSI=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_SWAP=y
CONFIG_PROC_PAGE_MONITOR=y
CONFIG_USERFAULTFD=y
CONFIG_FHANDLE=y
CONFIG_AUDIT=y

# Permissoes e atributos estendidos nos sistemas de arquivos
CONFIG_FS_POSIX_ACL=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# Rede basica (netd / sockets do Android)
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6=y

# Android 13 usa memfd no lugar do ashmem; SELinux fica desligado na fase inicial
CONFIG_SECURITY_SELINUX=n
