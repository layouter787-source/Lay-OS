# Fragmento de configuracao do kernel Lay-OS (x86_64, QEMU / desenvolvimento)
# Aplicado sobre 'make defconfig' pelo script tools/build/build-kernel.sh

# --- Boot, console e initramfs ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_NET_9P=y
CONFIG_9P_FS=y

# --- Binder (IPC do Android, base do Lay-Android) ---
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# --- Isolamento: namespaces e cgroups v2 (sandbox de apps e containers) ---
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_MEMFD_CREATE=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# --- Seguranca ---
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITYFS=y
CONFIG_BPF_SYSCALL=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_DM_VERITY=y
CONFIG_BLK_DEV_DM=y

# --- Rede e sistemas de arquivos para o sistema real ---
CONFIG_EXT4_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_INOTIFY_USER=y
CONFIG_TUN=y
CONFIG_BRIDGE=y
CONFIG_VETH=y
CONFIG_NETFILTER=y

# --- Graficos (base para o compositor Wayland) ---
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y

# --- Reduzir peso (compilacao mais rapida e imagem menor) ---
CONFIG_MODULES=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_SOUND=n
CONFIG_WLAN=n
CONFIG_WIRELESS=n
CONFIG_BT=n
CONFIG_USB_SUPPORT=n
CONFIG_HYPERV=n
CONFIG_XEN=n
CONFIG_INFINIBAND=n
CONFIG_DRM_AMDGPU=n
CONFIG_DRM_RADEON=n
CONFIG_DRM_NOUVEAU=n
CONFIG_DRM_I915=n
